README.md
docs/
docs/fr165-fields.local.md
seed/food-library.local.yaml

# Local database -- contains real health data
garmin-dashboard.db
*.db

# The previous build, kept locally for reference only -- not pushed.
reference/

# Personal documents -- DEXA scans, diet reports, anything with your name or body on it.
# Broad on purpose: it is far better to have to force-add a harmless PDF than to push a
# body-composition report to a public repository once.
*.pdf
private/
